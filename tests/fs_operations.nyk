local fs = require("@neyuki/fs")
local table = require("@neyuki/table")

local dir = ".fs-test-tmp"
local nested = dir .. "/inner/deep"
local path = dir .. "/notes.txt"
local moved = dir .. "/moved.txt"

-- Start from a clean slate in case an earlier run was interrupted.
if (fs.exists(path)) then fs.remove(path) end
if (fs.exists(moved)) then fs.remove(moved) end
if (fs.exists(nested)) then fs.remove(nested) end
if (fs.exists(dir .. "/inner")) then fs.remove(dir .. "/inner") end
if (fs.exists(dir)) then fs.remove(dir) end

assert(not fs.exists(dir), "temp dir should not exist yet")
fs.mkdir(dir)
assert(fs.exists(dir), "mkdir should create the directory")
assert(fs.isDir(dir), "isDir should be true for a directory")

fs.mkdir(nested, true)
assert(fs.isDir(nested), "recursive mkdir should create parents")

local ok, err = try(fs.mkdir, dir)
assert(not ok, "mkdir on an existing directory should error")

-- Write mode creates the file.
local file = fs.open(path, "w")
assert(file.path == path, "File.path should be the opened path")
file:write("first\n")
file:write("second\n", true)
file:close()

assert(fs.exists(path), "open with w should create the file")
assert(not fs.isDir(path), "isDir should be false for a file")

-- Read mode.
local reader = fs.open(path)
assert(reader:read() == "first\nsecond\n", "read should return the whole file")

local lines = {}
for line in reader:lines() do
    table.insert(lines, line)
end
assert(#lines == 2, "lines should yield one entry per line")
assert(lines[1] == "first" and lines[2] == "second", "lines should strip newlines")

local ok, err = try(reader.write, reader, "nope")
assert(not ok, "writing to a read-only file should error")
reader:close()

local ok, err = try(reader.read, reader)
assert(not ok, "reading a closed file should error")

-- Append mode always appends, and write without append replaces contents.
local appender = fs.open(path, "a")
appender:write("third\n")
appender:close()
assert(fs.open(path):read() == "first\nsecond\nthird\n", "append mode should append")

local writer = fs.open(path, "w")
writer:write("only")
writer:close()
assert(fs.open(path):read() == "only", "write without append should replace contents")

-- Opening a missing file for reading errors.
local ok, err = try(fs.open, dir .. "/missing.txt", "r")
assert(not ok, "open on a missing file should error")

-- Rename, list, remove.
fs.rename(path, moved)
assert(not fs.exists(path) and fs.exists(moved), "rename should move the file")

local entries = fs.list(dir)
assert(#entries == 2, "list should return both entries")
assert(entries[1] == "inner" and entries[2] == "moved.txt", "list should be sorted")

fs.remove(moved)
fs.remove(nested)
fs.remove(dir .. "/inner")
fs.remove(dir)
assert(not fs.exists(dir), "remove should delete the directory")

-- whole-file helpers, copying, info and walking
local tree = ".fs-test-tree"
if (fs.exists(tree)) then fs.remove(tree, true) end
fs.mkdir(tree .. "/sub/deeper", true)
fs.write(fs.join(tree, "a.txt"), "one\r\ntwo\n")
fs.append(fs.join(tree, "a.txt"), "three")
assert(fs.read(tree .. "/a.txt") == "one\r\ntwo\nthree", "write then append")
local collected = {}
for line in fs.lines(tree .. "/a.txt") do collected[#collected + 1] = line end
assert(table.concat(collected, ",") == "one,two,three", "lines strips line endings")
assert(fs.copy(tree .. "/a.txt", tree .. "/sub/deeper/b.txt") == 14, "copy returns the bytes copied")
fs.write(tree .. "/sub/c.md", "")

local info = fs.info(tree .. "/a.txt")
assert(info.size == 14 and info.isFile and not info.isDir, "info describes a file")
assert(type(info.modified) == "number" and info.modified > 0, "info has a modification time")
assert(fs.info(tree).isDir and fs.info(tree .. "/missing") == nil, "info for directories and missing paths")
assert(fs.isFile(tree .. "/a.txt") and not fs.isFile(tree), "isFile")

local walked = fs.walk(tree)
assert(table.concat(walked, ",") == "a.txt,sub/c.md,sub/deeper/b.txt", "walk lists files recursively: " .. table.concat(walked, ","))

assert(not try(fs.remove, tree), "removing a non-empty directory needs recursive")
fs.remove(tree, true)
assert(not fs.exists(tree), "recursive remove deletes everything")

-- paths
assert(fs.join("a", "b/", "c.txt") == "a/b/c.txt", "join")
assert(fs.join("a", "/root", "x") == "/root/x", "an absolute part starts over")
assert(fs.basename("docs/guide.md") == "guide.md" and fs.basename("a\\b") == "b", "basename")
assert(fs.dirname("docs/guide.md") == "docs" and fs.dirname("guide.md") == ".", "dirname")
assert(fs.extension("a.tar.gz") == ".gz" and fs.extension(".gitignore") == "", "extension")
assert(fs.absolute("x") == fs.join(fs.cwd(), "x") or #fs.absolute("x") > 1, "absolute")

-- readBuffer: any bytes, not just UTF-8
local png = fs.readBuffer("tests/fixtures/dot.png")
assert(type(png) == "buffer" and buffer.readstring(png, 1, 3) == "PNG", "readBuffer reads binary files")
assert(buffer.readu8(png, 0) == 0x89, "readBuffer keeps bytes that are not UTF-8")
local okMissing, missingErr = try(fs.readBuffer, "tests/fixtures/missing.bin")
assert(not okMissing and string.find(missingErr, "cannot read", 1, true) != nil, "readBuffer reports a missing file")
assert(not try(fs.readBuffer, nil), "readBuffer needs a path")
local big = dir .. "-big.bin"
fs.write(big, string.rep("x", 1024 * 1024 + 3))
local size = nil
task.spawn(function() size = buffer.len(fs.readBuffer(big)) end)
while size == nil do task.wait(0.01) end
assert(size == 1024 * 1024 + 3, "readBuffer reads large files inside a task")
fs.remove(big)

print("[pass] fs operations")
