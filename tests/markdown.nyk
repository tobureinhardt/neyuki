-- Tests for @neyuki/markdown: CommonMark, GFM (tables, task lists,
-- strikethrough, footnotes, alerts), plain-table AST, frontmatter,
-- plain text extraction and safe-by-default XSS protections.

local markdown = require("@neyuki/markdown")
local string = require("@neyuki/string")
local test = require("@neyuki/test")
local toml = require("@neyuki/toml")

local describe, it, expect = test.describe, test.it, test.expect

describe("@neyuki/markdown", function()
    it("renders CommonMark and GFM features to HTML", function()
        local src = [[
# Welcome

Paragraph with **bold**, *italic*, ~~strike~~ and `code`.

| Name | Score |
| :--- | ----: |
| Ada  | 100   |

- [x] done
- [ ] todo

```lua
print("hi")
```
]]
        local html = markdown.toHtml(src)
        expect(string.find(html, "<h1>Welcome</h1>", 1, true) != nil):toBe(true)
        expect(string.find(html, "<strong>bold</strong>", 1, true) != nil):toBe(true)
        expect(string.find(html, "<em>italic</em>", 1, true) != nil):toBe(true)
        expect(string.find(html, "<del>strike</del>", 1, true) != nil):toBe(true)
        expect(string.find(html, "<code>code</code>", 1, true) != nil):toBe(true)
        expect(string.find(html, "<table>", 1, true) != nil):toBe(true)
        expect(string.find(html, 'type="checkbox"', 1, true) != nil):toBe(true)
        expect(string.find(html, 'class="language-lua"', 1, true) != nil):toBe(true)
    end)

    it("blocks raw HTML and dangerous URL schemes by default", function()
        local xss = 'Hi <script>alert(1)</script> [click](javascript:alert(1)) ![x](data:text/html,hi) [safe](https://neyuki.cc)'
        local safe = markdown.toHtml(xss)
        expect(string.find(safe, "<script>", 1, true)):toBeNil()
        expect(string.find(safe, "&lt;script&gt;", 1, true) != nil):toBe(true)
        expect(string.find(safe, "javascript:", 1, true)):toBeNil()
        expect(string.find(safe, "data:text/html", 1, true)):toBeNil()
        expect(string.find(safe, 'href="https://neyuki.cc"', 1, true) != nil):toBe(true)

        local raw = markdown.toHtml("<div>raw</div>", { unsafeHtml = true })
        expect(string.find(raw, "<div>raw</div>", 1, true) != nil):toBe(true)
    end)

    it("supports headingIds, breaks and smart punctuation options", function()
        local h = markdown.toHtml("# Hello World\n\n## Hello World\n\n# Custom {#my-id}\n", {
            headingIds = true,
        })
        expect(string.find(h, '<h1 id="hello-world">Hello World</h1>', 1, true) != nil):toBe(true)
        expect(string.find(h, '<h2 id="hello-world-1">Hello World</h2>', 1, true) != nil):toBe(true)
        expect(string.find(h, '<h1 id="my-id">Custom</h1>', 1, true) != nil):toBe(true)

        local br = markdown.toHtml("line 1\nline 2", { breaks = true })
        expect(string.find(br, "<br />", 1, true) != nil):toBe(true)

        local smart = markdown.toHtml('"hello" --- world...', { smart = true })
        expect(string.find(smart, "—", 1, true) != nil):toBe(true)
        expect(string.find(smart, "…", 1, true) != nil):toBe(true)
    end)

    it("parses into plain-table AST nodes", function()
        local src = [[
---
title: Post
---

# Title

> [!NOTE]
> Heads up!

1. [x] First [link](https://neyuki.cc "Home")
2. [ ] Second ![logo](/logo.png)

| A | B |
| :-: | -: |
| 1 | 2 |

```rust
fn main() {}
```
]]
        local doc = markdown.parse(src, { headingIds = true })
        expect(doc.type):toBe("document")
        expect(doc.frontmatter.format):toBe("yaml")
        expect(doc.frontmatter.raw):toBe("title: Post\n")

        local heading = doc.children[1]
        expect(heading.type):toBe("heading")
        expect(heading.level):toBe(1)
        expect(heading.id):toBe("title")
        expect(heading.children[1].text):toBe("Title")

        local quote = doc.children[2]
        expect(quote.type):toBe("blockquote")
        expect(quote.kind):toBe("note")

        local list = doc.children[3]
        expect(list.type):toBe("list")
        expect(list.ordered):toBe(true)
        expect(list.start):toBe(1)
        expect(list.children[1].type):toBe("listItem")
        expect(list.children[1].checked):toBe(true)
        expect(list.children[2].checked):toBe(false)

        local tbl = doc.children[4]
        expect(tbl.type):toBe("table")
        expect(tbl.align):toEqual({ "center", "right" })
        expect(#tbl.head):toBe(2)
        expect(#tbl.rows):toBe(1)
        expect(markdown.text(tbl.rows[1][2])):toBe("2")

        local code = doc.children[5]
        expect(code.type):toBe("codeBlock")
        expect(code.lang):toBe("rust")
        expect(code.text):toBe("fn main() {}\n")
    end)

    it("extracts YAML and TOML frontmatter cleanly", function()
        local fm1, body1 = markdown.frontmatter("---\nauthor: Ada\n---\n# Guide\n")
        expect(fm1.format):toBe("yaml")
        expect(fm1.raw):toBe("author: Ada\n")
        expect(body1):toBe("# Guide\n")

        local fm2, body2 = markdown.frontmatter("+++\ntitle = \"Docs\"\n+++\nHello")
        expect(fm2.format):toBe("toml")
        expect(toml.decode(fm2.raw).title):toBe("Docs")
        expect(body2):toBe("Hello")

        local fm3, body3 = markdown.frontmatter("# No frontmatter")
        expect(fm3):toBeNil()
        expect(body3):toBe("# No frontmatter")

        -- Frontmatter is excluded from toHtml by default
        local rendered = markdown.toHtml("---\ntitle: Hidden\n---\nVisible")
        expect(string.find(rendered, "Hidden", 1, true)):toBeNil()
        expect(string.find(rendered, "<p>Visible</p>", 1, true) != nil):toBe(true)
    end)

    it("extracts plain text from both Markdown strings and AST nodes", function()
        expect(markdown.text("# Hello **world**\n\nVisit [Neyuki](https://neyuki.cc) with `code`.")):toBe("Hello world\nVisit Neyuki with code.")
        local doc = markdown.parse("One *two* **three**")
        expect(markdown.text(doc)):toBe("One two three")
    end)

    it("validates arguments and rejects deeply nested input", function()
        expect(function() markdown.toHtml(123) end):toThrow("string")
        expect(function() markdown.toHtml("hi", { gfm = "yes" }) end):toThrow("boolean")
        expect(function() markdown.parse(string.rep("> ", 300) .. "x") end):toThrow("nesting")
    end)
end)
