-- Regression tests for PR #107 review feedback. Every case must give the same
-- result at -O0 and -O1 (the test runner runs both).

-- 1. MIR constant folding must not track a local a closure can rewrite.
do
    local x
    local function f() x = 2 end
    local t = setmetatable({}, { __index = function() f() return 0 end })
    x = 1
    local _y = t.foo
    assert(x == 2, "captured local rewritten by __index must not fold to 1")
end

-- 2. Folded `and` / `or` / `??` keep cutting a call to one value.
do
    local function f() return 1, 2 end
    assert(select("#", true and f()) == 1, "true and f() is one value")
    assert(select("#", false or f()) == 1, "false or f() is one value")
    assert(select("#", nil ?? f()) == 1, "nil ?? f() is one value")
    local function g() return true and f() end
    assert(select("#", g()) == 1, "return true and f() is not a multi-value tail call")
    local function h(...) return false or ... end
    assert(select("#", h(1, 2, 3)) == 1, "false or ... is one value")
end

-- 3. `"" .. x` is folded only when x is a string literal: a concatenation can
-- return any value through __concat.
do
    local mt = { __concat = function() return 5 end }
    local t = setmetatable({}, mt)
    local u = setmetatable({}, mt)
    local r = "" .. (t .. u)
    assert(r == "5", "outer concat must still run on the __concat result")
    assert(type(r) == "string", "outer concat must still produce a string")
end

-- 4. Numeric for loops whose count or start index does not fit an inline int.
do
    local n = 0
    for i = 1, 200000000000000 do
        if i > 3 then break end
        n = n + 1
    end
    assert(n == 3, "large-limit loop runs its first iterations")

    local m = 0
    for i = -140737488355328, -140737488355320 do
        m = m + 1
    end
    assert(m == 9, "loop starting at the inline-int minimum")

    local last
    for i = 140737488355320, 140737488355330 do
        last = i
    end
    assert(last == 140737488355330, "loop crossing the inline-int maximum")
end

-- 5. A nil in the array or hash part still goes through __index.
do
    local t = { 1, 2, 3 }
    t[2] = nil
    setmetatable(t, { __index = function() return 42 end })
    assert(t[2] == 42, "nil array slot must call __index")
    local i = 2
    assert(t[i] == 42, "nil array slot through a register key must call __index")

    local r = { a = 1, b = 2 }
    r.a = nil
    setmetatable(r, { __index = function(_, k) return "dflt_" .. k end })
    for _ = 1, 3 do
        -- Repeated reads go through the inline cache.
        assert(r.a == "dflt_a", "nil field must call __index")
    end
    assert(r.b == 2, "present field still reads directly")
end

-- 6. Integer/float equality is exact above 2^53.
do
    local big = 9007199254740993
    local f = 9007199254740992.0
    assert(big ~= f, "2^53 + 1 is not 2^53")
    assert(not rawequal(big, f), "rawequal is exact too")
    assert(9007199254740992 == f, "2^53 equals 2^53.0")
    assert(9223372036854775807 ~= 2.0 ^ 63, "i64 max is not 2^63")
    assert((1 << 63) == 2.0 ^ 63, "BigInt 2^63 equals 2^63.0")
    assert((1 << 63) + 1 ~= 2.0 ^ 63, "BigInt 2^63 + 1 is not 2^63.0")
end

print("review_regression_pr107: ok")
